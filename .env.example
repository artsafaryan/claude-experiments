# Influencer Automation - Environment Variables
# Copy this file to .env and fill in your values

# ===================
# Claude API (Required)
# ===================
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ===================
# Gmail OAuth (Required)
# ===================
# Download credentials.json from Google Cloud Console
# Place it in the project root directory
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# ===================
# Slack Bot (Required for approval workflow)
# ===================
# See docs/SLACK_SETUP.md for detailed setup instructions

# Bot Token - starts with xoxb-
# Found in: Slack App > OAuth & Permissions > Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Signing Secret - used to verify requests from Slack
# Found in: Slack App > Basic Information > App Credentials > Signing Secret
SLACK_SIGNING_SECRET=your-signing-secret

# App-Level Token - starts with xapp- (Required for Socket Mode)
# Found in: Slack App > Basic Information > App-Level Tokens
# Must have connections:write scope
SLACK_APP_TOKEN=xapp-your-app-token

# ===================
# Database (Optional - defaults to SQLite)
# ===================
# For SQLite (default, good for testing):
DATABASE_URL=sqlite:///./influencer_automation.db

# For PostgreSQL (recommended for production):
# DATABASE_URL=postgresql://user:password@localhost:5432/influencer_automation

# ===================
# Application Settings
# ===================
ENVIRONMENT=development
LOG_LEVEL=INFO
