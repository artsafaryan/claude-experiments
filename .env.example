# Influencer Automation - Environment Variables
# Copy this file to .env and fill in your values

# ===================
# Claude API (Required)
# ===================
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===================
# Gmail OAuth (Required)
# ===================
# Download credentials.json from Google Cloud Console
# Place it in the project root directory
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# ===================
# Slack Bot (Required for approvals)
# ===================
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token  # For Socket Mode

# ===================
# Database (Optional - defaults to SQLite)
# ===================
# For SQLite (default):
DATABASE_URL=sqlite:///./influencer_automation.db

# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/influencer_automation

# ===================
# Application Settings
# ===================
ENVIRONMENT=development
LOG_LEVEL=INFO
